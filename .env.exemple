# make env — сгенерирует APP_API_KEY и POSTGRES_PASSWORD
APP_API_KEY=

POSTGRES_HOST=postgres
POSTGRES_DB=tcloud
POSTGRES_USER=tcloud
POSTGRES_PASSWORD=

# https://my.telegram.org → API development tools; нужен пользовательский аккаунт, не бот
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Существующие приватные каналы, которые подключить как хранилища при старте (через запятую)
TELEGRAM_CHATS=
