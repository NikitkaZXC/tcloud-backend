# make env — сгенерирует APP_SECRET_KEY, APP_ENCRYPTION_KEY, ROOT_PASSWORD, пароли POSTGRES, RABBITMQ, REDIS, FLOWER
# и RS256-ключи JWT в certs/
# Не короче 32 символов, иначе приложение не стартует
APP_SECRET_KEY=
# Ключ шифрования файлов с encrypt=true: 32 байта в base64. Потеря или смена ключа = потеря зашифрованных файлов,
# храните копию отдельно от сервера. Пусто — загрузки с encrypt=true получают 503 encryption_unavailable
APP_ENCRYPTION_KEY=

# Главный пользователь: создаётся при старте API, пароль синхронизируется с .env (docs/flows/users.md)
ROOT_LOGIN=root
# Не короче 12 символов
ROOT_PASSWORD=
# Куки только по HTTPS; для http://127.0.0.1 в Safari и скриптах поставьте false
# JWT_SECURE=true
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
# JWT_MAX_FAILED_LOGINS=5
# JWT_LOCK_MINUTES=15
# Rate limiting (docs/security.md): правило задаётся парой LIMIT + WINDOW
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_SIGNIN_IP__LIMIT=20
# RATE_LIMIT_SIGNIN_IP__WINDOW=60
# RATE_LIMIT_API_USER__LIMIT=1200
# RATE_LIMIT_API_USER__WINDOW=60
# IP/подсеть reverse proxy перед API (nginx фронтенда), никогда *
# FORWARDED_ALLOW_IPS=127.0.0.1
# CORS origins (JSON list); empty when the frontend is on the same origin (site.com + site.com/api)
# APP_ALLOWED_ORIGINS=["http://localhost:3000"]
# APP_IS_ALLOWED_CREDENTIALS=true
# APP_ALLOWED_METHODS=["*"]
# APP_ALLOWED_HEADERS=["*"]
# Swagger; в docker-compose.prod.yml пусто (выключен), пустое значение убирает маршрут
# APP_DOCS_URL=/docs
# APP_OPENAPI_URL=/openapi.json
# APP_REDOC_URL=/redoc

POSTGRES_HOST=postgres
POSTGRES_DB=tcloud
POSTGRES_USER=tcloud
POSTGRES_PASSWORD=

RABBITMQ_USER=tcloud
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
# Сколько секунд Redis держит сведения из Telegram (каналы, аккаунт, аватарки, превью)
# REDIS_CACHE_TTL=180
# Потолок памяти Redis под превью открытых файлов из Telegram, МБ (0 — не кешировать)
# REDIS_THUMB_CACHE_MB=64
# Панель очередей http://127.0.0.1:5555
FLOWER_USER=tcloud
FLOWER_PASSWORD=

# https://my.telegram.org → API development tools; нужен пользовательский аккаунт, не бот
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Существующие приватные каналы, которые подключить как хранилища при старте (через запятую)
TELEGRAM_CHATS=
# Вход в Telegram — после запуска на странице /telegram фронтенда или на /docs в dev (docs/flows/auth.md)
# TELEGRAM_LOGIN_TTL=300
# TELEGRAM_SESSION_SWEEP_INTERVAL=3600
# Параллельных отправок в Telegram = потоков worker-telegram
# TELEGRAM_CONCURRENCY=2
# TELEGRAM_UPLOAD_WORKERS=4
# TELEGRAM_FLOOD_MAX_WAIT=3600

CLAMAV_HOST=clamav
# Файлы больше — без антивируса, предупреждение too_big_to_scan; равен MaxFileSize в docker/clamd.conf
# CLAMAV_MAX_FILE_SIZE=2147483645
# CLAMAV_TIMEOUT=1860

# Потоков worker-download (скачивание по ссылке) и worker-prepare (проверка, антивирус)
# UPLOAD_DOWNLOAD_CONCURRENCY=4
# UPLOAD_PREPARE_CONCURRENCY=4
# Активных задач и файлов одновременно в tmp до отправки в Telegram; 0 — без ограничений (держит только место на диске)
# UPLOAD_MAX_ACTIVE_TASKS=0
# UPLOAD_MAX_FILES_ON_DISK=0
# UPLOAD_TASK_TTL=604800
# UPLOAD_MIN_FREE_DISK_MB=1024
# Через сколько секунд удалять из tmp файлы без активной задачи
# UPLOAD_ORPHAN_AGE=3600
# UPLOAD_ARCHIVE_TTL=86400
# Сколько файлов и папок можно выбрать для одного архива (POST /api/folders/archive/selection)
# UPLOAD_ARCHIVE_MAX_ITEMS=1000
