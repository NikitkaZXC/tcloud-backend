# python -m tcloud genkey — сгенерирует оба ключа
TCLOUD_API_KEY=
# Мастер-ключ шифрования. ПОТЕРЯЕТЕ ЕГО — ПОТЕРЯЕТЕ ВСЕ ФАЙЛЫ. Храните копию отдельно.
TCLOUD_MASTER_KEY=

# https://my.telegram.org → API development tools
TCLOUD_TG_API_ID=
TCLOUD_TG_API_HASH=

# Вариант 1: бот (проще, без входа по номеру). Бот должен быть админом канала.
TCLOUD_TG_BOT_TOKEN=
# Вариант 2: аккаунт (python -m tcloud login ...). С Premium можно части до 4 ГБ.
TCLOUD_TG_SESSION_STRING=

# Приватный канал: -100xxxxxxxxxx. Для аккаунта можно "me" (Избранное), но канал надёжнее.
TCLOUD_TG_CHAT_ID=
# TCLOUD_TG_PROXY_URL=socks5://user:pass@host:1080

# TCLOUD_DATA_DIR=data
# TCLOUD_PART_SIZE_MB=1900      # для Premium: 3900
# TCLOUD_TG_MAX_UPLOAD_MB=2000  # для Premium: 4000
# TCLOUD_HOST=127.0.0.1
# TCLOUD_PORT=8000
