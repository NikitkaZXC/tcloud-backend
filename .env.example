# docker compose run --rm app python -m tcloud genkey — сгенерирует оба значения
TCLOUD_API_KEY=
# Только буквы, цифры, - и _ (подставляется в URL подключения к БД)
TCLOUD_DB_PASSWORD=

# https://my.telegram.org → API development tools. Нужен пользовательский аккаунт, не бот
TCLOUD_TG_API_ID=
TCLOUD_TG_API_HASH=

# Существующие приватные каналы, которые подключить как хранилища при старте (через запятую)
# TCLOUD_CHATS=-1001234567890,-1009876543210

# TCLOUD_TG_CONCURRENCY=2   # одновременных выгрузок в Telegram
